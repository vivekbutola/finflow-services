# App
APP_NAME=wallet-service
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://wallet_service:wallet_service_password@localhost:5432/wallet_service_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=false

# JWT — must match auth-service's signing configuration exactly
JWT_SECRET_KEY=change-me-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_ISSUER=auth-service
JWT_AUDIENCE=fintech-platform

# Wallet business rules
WALLET_DEFAULT_CURRENCY=INR

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Logging
LOG_LEVEL=INFO
