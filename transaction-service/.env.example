# App
APP_NAME=transaction-service
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://transaction_service:transaction_service_password@localhost:5432/transaction_service_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO=false

# JWT — must match auth-service's signing configuration exactly
JWT_SECRET_KEY=change-me-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_ISSUER=auth-service
JWT_AUDIENCE=fintech-platform

# wallet-service integration (service-to-service, not the user-facing API)
# transaction-service moves money by calling an internal wallet-service API
# keyed by wallet_id and guarded by a shared secret, since the public
# /api/v1/wallet/* endpoints only ever operate on "the caller's own wallet"
# as resolved from a user JWT and cannot debit/credit an arbitrary wallet_id.
WALLET_SERVICE_BASE_URL=http://wallet-service:8000
WALLET_SERVICE_INTERNAL_API_KEY=change-me-to-a-long-random-shared-secret-in-production
WALLET_SERVICE_TIMEOUT_SECONDS=5.0

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# Logging
LOG_LEVEL=INFO
